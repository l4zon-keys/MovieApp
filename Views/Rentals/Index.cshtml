@model IEnumerable<MovieApp.Models.Rental>

@{
    ViewData["Title"] = "Rentals";
}
<partial name="_Alert" />

<h1>Rentals</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">New Rental</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Movie</th>
            <th>Rented On</th>
            <th>Due On</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rental in Model)
        {
            <tr>
                <td>@rental.Customer?.FullName</td>
                <td>@rental.Movie?.Title</td>
                <td>@rental.RentedOn.ToShortDateString()</td>
                <td>@rental.DueOn.ToShortDateString()</td>
                <td>
                    @if (rental.IsReturned)
                    {
                        <span class="text-success">Returned @rental.ReturnedOn?.ToShortDateString()</span>
                    }
                    else if (rental.IsOverdue)
                    {
                        <span class="text-danger">Overdue</span>
                    }
                    else
                    {
                        <span class="text-warning">Out</span>
                    }
                </td>
                <td>
                    @if (!rental.IsReturned)
                    {
                        <a asp-action="Return" asp-route-id="@rental.Id">Return</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>