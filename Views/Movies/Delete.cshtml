@model MovieApp.Models.Movie

@{
    ViewData["Title"] = "Delete DVD";
}

<h1>Delete DVD</h1>
<h3>Are you sure you want to delete this?</h3>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Title)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Title)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Genre)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Genre)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.ReleaseYear)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.ReleaseYear)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Rating)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Rating)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.QuantityInStock)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.QuantityInStock)</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
