@model MovieApp.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<h1>Delete Customer</h1>
<h3>Are you sure you want to delete this?</h3>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FullName)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.FullName)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.PhoneNumber)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.PhoneNumber)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.Email)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.JoinedOn)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.JoinedOn)</dd>
   
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>